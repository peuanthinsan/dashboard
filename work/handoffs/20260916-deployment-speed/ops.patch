+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+
+function within(root, target) {
+  const relative = path.relative(root, target);
+  return relative === '' || (!relative.startsWith('..' + path.sep) && relative !== '..' && !path.isAbsolute(relative));
+}
+function assertNoLinks(target) {
+  let probe = path.resolve(target);
+  while (true) {
+    try { if (fs.lstatSync(probe).isSymbolicLink()) throw new Error('Build cache paths must not contain links'); }
+    catch (error) { if (error.code !== 'ENOENT') throw error; }
+    const parent = path.dirname(probe);
+    if (parent === probe) break;
+    probe = parent;
+  }
+}
+function assertPlainTree(directory) {
+  assertNoLinks(directory);
+  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+    const filename = path.join(directory, entry.name);
+    if (entry.isSymbolicLink()) throw new Error('Build cache must not contain links');
+    if (entry.isDirectory()) assertPlainTree(filename);
+    else if (!entry.isFile()) throw new Error('Build cache must contain only ordinary files');
+  }
+}
+// Restore only secret-free build caches. npm ci, tests and compilation still run.
+function createBuildCache(directory, { root, destination, app, publicSettings, warn = console.warn }) {
+  if (!directory) return null;
+  if (!path.isAbsolute(directory)) throw new Error('Build cache directory must be absolute');
+  const base = path.resolve(directory);
+  for (const other of [root, destination]) {
+    if (within(base, other) || within(other, base)) throw new Error('Build cache must be separate from source and release');
+  }
+  assertNoLinks(base);
+  const fingerprint = crypto.createHash('sha256');
+  fingerprint.update(JSON.stringify({ schema: 1, app, platform: process.platform, arch: process.arch, node: process.version,
+    settings: Object.entries(publicSettings).sort(([a], [b]) => a.localeCompare(b)) }));
+  const applicationRoot = app === 'ops' ? path.join(root, 'web') : root;
+  for (const name of ['package.json', 'package-lock.json', 'next.config.js', 'next.config.mjs', 'next.config.ts']) {
+    const filename = path.join(applicationRoot, name);
+    if (fs.existsSync(filename)) fingerprint.update(name).update(fs.readFileSync(filename));
+  }
+  const key = fingerprint.digest('hex');
+  const saved = path.join(base, 'next', key);
+  const local = path.join(applicationRoot, '.next', 'cache');
+  const warning = error => warn('[build-cache] Cache unavailable: ' + error.message);
+  function removeOwned(target, owner) {
+    if (target === owner || !within(owner, target)) throw new Error('Cache cleanup escapes its directory');
+    assertNoLinks(target);
+    fs.rmSync(target, { recursive: true, force: true });
+  }
+  return {
+    key,
+    npmDirectory: path.join(base, 'npm'),
+    initialize() {
+      assertNoLinks(path.join(base, 'npm'));
+      fs.mkdirSync(path.join(base, 'npm'), { recursive: true });
+    },
+    restore() {
+      if (!fs.existsSync(saved)) return false;
+      try {
+        assertPlainTree(saved);
+        assertNoLinks(local);
+        fs.cpSync(saved, local, { recursive: true });
+        return true;
+      } catch (error) {
+        warning(error);
+        removeOwned(local, root);
+        return false;
+      }
+    },
+    save() {
+      if (!fs.existsSync(local)) return;
+      const staging = path.join(base, 'next', key + '-' + crypto.randomUUID() + '.tmp');
+      try {
+        assertPlainTree(local);
+        assertNoLinks(staging);
+        fs.cpSync(local, staging, { recursive: true });
+        removeOwned(saved, base);
+        fs.renameSync(staging, saved);
+        const parent = path.dirname(saved);
+        const entries = fs.readdirSync(parent, { withFileTypes: true })
+          .filter(entry => entry.isDirectory() && /^[0-9a-f]{64}$/.test(entry.name))
+          .map(entry => ({ name: entry.name, modified: fs.statSync(path.join(parent, entry.name)).mtimeMs }))
+          .sort((a, b) => a.name === key ? -1 : b.name === key ? 1 : b.modified - a.modified);
+        for (const entry of entries.slice(3)) removeOwned(path.join(parent, entry.name), base);
+      } catch (error) { warning(error); }
+      finally { if (fs.existsSync(staging)) removeOwned(staging, base); }
+    },
+  };
+}
+module.exports = { createBuildCache };
