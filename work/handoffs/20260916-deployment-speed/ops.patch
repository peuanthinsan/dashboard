@@ -0,0 +1,71 @@
+'use strict';
+const test=require('node:test'),assert=require('node:assert/strict'),fs=require('node:fs'),os=require('node:os'),path=require('node:path');
+const {createBuildCache}=require('./build-cache.cjs');
+const {build}=require('./build.cjs');
+function fixture(t) {
+  const base=fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(),'songdee-cache-test-')));
+  t.after(()=>fs.rmSync(base,{recursive:true,force:true}));
+  const root=path.join(base,'source'),destination=path.join(base,'release'),cache=path.join(base,'cache');
+  fs.mkdirSync(root);fs.writeFileSync(path.join(root,'package-lock.json'),'{"lockfileVersion":3}');
+  const options={root,destination,app:'dashboard',publicSettings:{}};
+  return {base,root,destination,cache,options};
+}
+test('cache hits across clean checkouts, without restoring application output',t=>{
+  const f=fixture(t),first=createBuildCache(f.cache,f.options);
+  first.initialize();assert.equal(first.restore(),false);
+  fs.mkdirSync(path.join(f.root,'.next/cache'),{recursive:true});
+  fs.writeFileSync(path.join(f.root,'.next/cache/data'),'compiler data');
+  fs.writeFileSync(path.join(f.root,'.next/server.js'),'must not be cached');first.save();
+  const second=path.join(f.base,'second');fs.mkdirSync(second);
+  fs.copyFileSync(path.join(f.root,'package-lock.json'),path.join(second,'package-lock.json'));
+  const cache=createBuildCache(f.cache,{...f.options,root:second});
+  assert.equal(cache.key,first.key);assert.equal(cache.restore(),true);
+  assert.equal(fs.readFileSync(path.join(second,'.next/cache/data'),'utf8'),'compiler data');
+  assert.equal(fs.existsSync(path.join(second,'.next/server.js')),false);
+});
+test('lockfile, public settings, app and Next configuration changes isolate cache entries',t=>{
+  const f=fixture(t),first=createBuildCache(f.cache,f.options).key;
+  assert.notEqual(createBuildCache(f.cache,{...f.options,publicSettings:{NEXT_PUBLIC_ORIGIN:'new'}}).key,first);
+  assert.notEqual(createBuildCache(f.cache,{...f.options,app:'svis'}).key,first);
+  fs.writeFileSync(path.join(f.root,'next.config.mjs'),'export default {}');
+  assert.notEqual(createBuildCache(f.cache,f.options).key,first);
+  fs.unlinkSync(path.join(f.root,'next.config.mjs'));
+  fs.writeFileSync(path.join(f.root,'package-lock.json'),'{"lockfileVersion":3,"changed":true}');
+  assert.notEqual(createBuildCache(f.cache,f.options).key,first);
+});
+test('cache overlap and filesystem links cannot redirect writes',t=>{
+  const f=fixture(t);
+  for(const target of [f.root,f.base,f.destination,path.join(f.root,'cache'),path.join(f.destination,'cache')]) {
+    assert.throws(()=>createBuildCache(target,f.options),/separate/);
+  }
+  fs.mkdirSync(f.cache);const alias=path.join(f.base,'alias');
+  fs.symlinkSync(f.cache,alias,process.platform==='win32'?'junction':'dir');
+  assert.throws(()=>createBuildCache(alias,f.options),/links/);
+});
+test('linked cache entry is ignored without reading or altering its target',t=>{
+  const f=fixture(t),warnings=[],cache=createBuildCache(f.cache,{...f.options,warn:message=>warnings.push(message)});
+  const saved=path.join(f.cache,'next',cache.key);fs.mkdirSync(saved,{recursive:true});
+  const outside=path.join(f.base,'outside');fs.mkdirSync(outside);fs.writeFileSync(path.join(outside,'private'),'not a build cache');
+  fs.symlinkSync(outside,path.join(saved,'redirect'),process.platform==='win32'?'junction':'dir');
+  assert.equal(cache.restore(),false);assert.equal(warnings.length,1);
+  assert.equal(fs.existsSync(path.join(f.root,'.next/cache/redirect/private')),false);
+  assert.equal(fs.readFileSync(path.join(outside,'private'),'utf8'),'not a build cache');
+});
+test('cached builds install locked dependencies and still stop on failed tests',t=>{
+  const f=fixture(t);
+  fs.mkdirSync(path.join(f.root,'hosting'));fs.writeFileSync(path.join(f.root,'hosting/app.json'),'{"app":"dashboard"}');
+  const config=path.join(f.base,'public.json');fs.writeFileSync(config,'{}');
+  const node=path.join(f.base,'runtime/node');fs.mkdirSync(path.dirname(node));fs.writeFileSync(node,'');
+  fs.mkdirSync(path.join(f.base,'runtime/node_modules/npm/bin'),{recursive:true});
+  fs.writeFileSync(path.join(f.base,'runtime/node_modules/npm/bin/npm-cli.js'),'');
+  const calls=[];
+  assert.throws(()=>build(config,f.destination,{root:f.root,execPath:node,cacheDirectory:f.cache,
+    environment:{NPM_CONFIG_CACHE:'untrusted',AUTH_SECRET:'must not leak'},
+    spawnSync:(command,args,options)=>{calls.push({args,env:options.env});return {status:args.some(arg=>arg.includes('vitest'))?1:0};}
+  }),/Build command failed/);
+  assert.equal(calls.length,2);assert.equal(calls[0].args[1],'ci');
+  assert.equal(calls[0].env.NPM_CONFIG_CACHE,path.join(f.cache,'npm'));
+  assert.equal(calls[0].env.NPM_CONFIG_PREFER_OFFLINE,'true');
+  assert.equal(JSON.stringify(calls).includes('must not leak'),false);
+  assert.equal(fs.existsSync(f.destination),false);
+});
