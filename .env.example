# =============================================================================
# Songdee Dashboard - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# Create a Postgres database at https://vercel.com/postgres or use any Postgres provider.
# For Vercel Postgres, all three URLs are auto-provisioned when you link the project.

# Primary connection string (pooled, used by the app)
POSTGRES_URL=

# Vercel Postgres optional URLs (used if you create DB via Vercel)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# -----------------------------------------------------------------------------
# Authentication (NextAuth / Auth.js)
# -----------------------------------------------------------------------------
# Required: Used for session signing and encryption.
# Generate one at: https://generate-secret.vercel.app/32

AUTH_SECRET=

# Optional: Override the canonical URL (defaults to VERCEL_URL in production).
# Set for local dev if needed, e.g. http://localhost:3000
# AUTH_URL=

# -----------------------------------------------------------------------------
# Google Maps (Location Data v1)
# -----------------------------------------------------------------------------
# Browser key for the Maps JavaScript API. Restrict it by HTTP referrer in
# Google Cloud Console and configure the same variable in deployed environments.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
